{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email == 'song4mi12@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'song4mi12@gmail.com')",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "shared": {
      "photoUploadControl": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'song4mi12@gmail.com'"
      },
      "lyricSync": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'song4mi12@gmail.com'"
      },
      "templeVerifyPoints": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'song4mi12@gmail.com'"
      },
      "secretAtlasPublication": {
        "haeinsa-001": {
          ".read": true,
          ".write": "auth != null && auth.token.email == 'song4mi12@gmail.com' && auth.token.email_verified == true && auth.token.firebase.sign_in_provider == 'google.com' && newData.exists()",
          ".validate": "newData.hasChildren(['public', 'updatedAt'])",
          "public": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "community": {
      "posts": {
        ".read": true,
        "$postId": {
          ".write": "auth != null && (auth.token.email == 'song4mi12@gmail.com' || (!data.exists() && newData.child('uid').val() == auth.uid) || (data.exists() && data.child('uid').val() == auth.uid))"
        }
      },
      "comments": {
        ".read": true,
        "$postId": {
          "$commentId": {
            ".write": "auth != null && (auth.token.email == 'song4mi12@gmail.com' || (!data.exists() && newData.child('uid').val() == auth.uid) || (data.exists() && data.child('uid').val() == auth.uid))"
          }
        }
      },
      "reports": {
        ".read": "auth != null && auth.token.email == 'song4mi12@gmail.com'",
        "$reportId": {
          ".write": "auth != null"
        }
      }
    },
    "leaderboards": {
      "beatShooter": {
        ".read": "auth != null",
        ".indexOn": [
          "score"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    }
  }
}
