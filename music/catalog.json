  {
    "musicId": "haeinsa-palman",
    "templeId": "temple:해인사",
    "templeName": "해인사",
    "title": "팔만의 바람",
    "artist": "산사노트",
    "audioUrl": "/music/haeinsa-palman.mp3",
    "coverUrl": "/images/temple-covers/haeinsa-hapcheon.webp",
    "duration": 269.4,
    "published": true,
    "rightsConfirmed": true,
    "lyrics": [
      {
        "t": null,
        "text": "[Intro – Whisper, Atmospheric]"
      },
      {
        "t": null,
        "text": "가야산에 바람이 분다"
      },
      {
        "t": null,
        "text": "천 년을 건너온 소리가 들린다"
      },
      {
        "t": null,
        "text": "숨을 고르고"
      },
      {
        "t": null,
        "text": "귀를 기울여"
      },
      {
        "t": null,
        "text": "나무 속에 잠든 시간을 깨워"
      },
      {
        "t": null,
        "text": "[Verse 1]"
      },
      {
        "t": null,
        "text": "구름은 산허리를 감고"
      },
      {
        "t": null,
        "text": "발끝엔 오래된 길이 흐르고"
      },
      {
        "t": null,
        "text": "한 걸음, 또 한 걸음"
      },
      {
        "t": null,
        "text": "세상의 소음이 멀어진다"
      },
      {
        "t": null,
        "text": "해인사 깊은 처마 아래"
      },
      {
        "t": null,
        "text": "바람이 넘기는 오래된 페이지"
      },
      {
        "t": null,
        "text": "먹으로 쓴 글은 아니야"
      },
      {
        "t": null,
        "text": "나무에 새긴 간절한 기도야"
      },
      {
        "t": null,
        "text": "[Pre-Chorus]"
      },
      {
        "t": null,
        "text": "한 글자에 하나의 마음"
      },
      {
        "t": null,
        "text": "한 칼끝에 하나의 세상"
      },
      {
        "t": null,
        "text": "사라질 듯 사라지지 않는"
      },
      {
        "t": null,
        "text": "그 이름을 불러"
      },
      {
        "t": null,
        "text": "[Chorus – Expansive, Melodic]"
      },
      {
        "t": null,
        "text": "팔만의 바람아, 불어라"
      },
      {
        "t": null,
        "text": "천 년의 시간을 넘어라"
      },
      {
        "t": null,
        "text": "가야산 구름 위로"
      },
      {
        "t": null,
        "text": "우리의 노래를 띄워라"
      },
      {
        "t": null,
        "text": "새겨라, 새겨라"
      },
      {
        "t": null,
        "text": "지워지지 않을 마음을"
      },
      {
        "t": null,
        "text": "흘러라, 흘러라"
      },
      {
        "t": null,
        "text": "끝나지 않을 시간을"
      },
      {
        "t": null,
        "text": "Oh— 바람이 되어"
      },
      {
        "t": null,
        "text": "Oh— 다시 피어나"
      },
      {
        "t": null,
        "text": "[Verse 2 – Rhythmic Groove]"
      },
      {
        "t": null,
        "text": "장경판전 문틈 사이"
      },
      {
        "t": null,
        "text": "빛과 바람이 춤을 추지"
      },
      {
        "t": null,
        "text": "나무는 숨 쉬고"
      },
      {
        "t": null,
        "text": "시간은 멈추고"
      },
      {
        "t": null,
        "text": "글자마다 우주가 열리지"
      },
      {
        "t": null,
        "text": "칼끝에서 피어난 지혜"
      },
      {
        "t": null,
        "text": "두려움 속에 새겨진 소원"
      },
      {
        "t": null,
        "text": "세상이 흔들리던 날에도"
      },
      {
        "t": null,
        "text": "사람들은 희망을 새겼어"
      },
      {
        "t": null,
        "text": "[Pre-Chorus]"
      },
      {
        "t": null,
        "text": "누군가의 간절한 하루"
      },
      {
        "t": null,
        "text": "누군가의 끝없는 기도"
      },
      {
        "t": null,
        "text": "그 마음이 모여서"
      },
      {
        "t": null,
        "text": "오늘의 우리를 부르네"
      },
      {
        "t": null,
        "text": "[Chorus]"
      },
      {
        "t": null,
        "text": "팔만의 바람아, 불어라"
      },
      {
        "t": null,
        "text": "천 년의 시간을 넘어라"
      },
      {
        "t": null,
        "text": "가야산 구름 위로"
      },
      {
        "t": null,
        "text": "우리의 노래를 띄워라"
      },
      {
        "t": null,
        "text": "새겨라, 새겨라"
      },
      {
        "t": null,
        "text": "지워지지 않을 마음을"
      },
      {
        "t": null,
        "text": "흘러라, 흘러라"
      },
      {
        "t": null,
        "text": "끝나지 않을 시간을"
      },
      {
        "t": null,
        "text": "[Bridge – Minimal, Hypnotic]"
      },
      {
        "t": null,
        "text": "비워야 보이는 것"
      },
      {
        "t": null,
        "text": "멈춰야 들리는 것"
      },
      {
        "t": null,
        "text": "바람은 글자를 읽고"
      },
      {
        "t": null,
        "text": "나무는 세월을 품고"
      },
      {
        "t": null,
        "text": "그토록 먼 시간 끝에"
      },
      {
        "t": null,
        "text": "우리는 여기 서 있네"
      },
      {
        "t": null,
        "text": "[Final Chorus – Emotional, Not Heavy]"
      },
      {
        "t": null,
        "text": "팔만의 바람아, 불어라"
      },
      {
        "t": null,
        "text": "잠든 세상을 깨워라"
      },
      {
        "t": null,
        "text": "해인사 저 깊은 곳에"
      },
      {
        "t": null,
        "text": "아직도 살아 있는 노래"
      },
      {
        "t": null,
        "text": "새겨라, 새겨라"
      },
      {
        "t": null,
        "text": "사라지지 않을 마음을"
      },
      {
        "t": null,
        "text": "빛나라, 빛나라"
      },
      {
        "t": null,
        "text": "천 년을 건너온 지혜여"
      },
      {
        "t": null,
        "text": "[Outro – Soft, Echoing]"
      },
      {
        "t": null,
        "text": "가야산에 바람이 분다"
      },
      {
        "t": null,
        "text": "나무에 새긴 마음이 운다"
      },
      {
        "t": null,
        "text": "천 년을 지나"
      },
      {
        "t": null,
        "text": "오늘도 살아"
      },
      {
        "t": null,
        "text": "바람이 읽는다"
      },
      {
        "t": null,
        "text": "우리가 듣는다"
      }
    ],
    "lyricsTextUrl": "/music/lyrics/haeinsa-palman.txt"
  }
]
