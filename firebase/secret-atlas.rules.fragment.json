{
  "rules": {
    "users": {
      "$uid": {
        "secretAtlas": {
          "haeinsa-001": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            "version": { ".validate": "newData.isNumber() && newData.val() === 1" },
            "position": {
              ".validate": "newData.hasChildren(['scene', 'at'])",
              "scene": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11 && newData.val() % 1 === 0" },
              "at": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 86400000" },
              "$other": { ".validate": false }
            },
            "completed": {
              "$scene": { ".validate": "$scene.matches(/^(?:[1-9]|1[0-2])$/) && newData.isNumber() && newData.val() > 0 && newData.val() <= now + 86400000" }
            },
            "cards": {
              "001": { ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || newData.val() === data.val()) && newData.parent().parent().child('completed').hasChildren(['1','2','3','4'])" },
              "002": { ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || newData.val() === data.val()) && newData.parent().parent().child('completed').hasChildren(['5','6','7','8'])" },
              "003": { ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || newData.val() === data.val()) && newData.parent().parent().child('completed').hasChildren(['9','10','11','12'])" },
              "$other": { ".validate": false }
            },
            "answers": {
              "$question": {
                ".validate": "$question.matches(/^q[1-6]$/) && newData.hasChildren(['selection','correct','at','attempts'])",
                "selection": { "$index": { ".validate": "$index.matches(/^[0-5]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 === 0" } },
                "correct": { ".validate": "newData.isBoolean()" },
                "at": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 86400000" },
                "attempts": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000 && newData.val() % 1 === 0" },
                "$other": { ".validate": false }
              }
            },
            "note": {
              ".validate": "newData.hasChildren(['at'])",
              "text": { ".validate": "newData.isString() && newData.val().length <= 10000" },
              "at": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 86400000" },
              "$other": { ".validate": false }
            },
            "lastReadAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 86400000" },
            "fieldVerification": {
              ".validate": "newData.hasChildren(['templeId','visitId','at']) && root.child('users').child($uid).child('destinations').child(newData.child('templeId').val()).child('name').val() === '해인사' && root.child('users').child($uid).child('destinations').child(newData.child('templeId').val()).child('visits').child(newData.child('visitId').val()).child('verified').val() === true",
              "templeId": { ".validate": "newData.isString() && newData.val().length <= 120" },
              "visitId": { ".validate": "newData.isString() && newData.val().length <= 120" },
              "at": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
